# models/phi35_gv/Modelfile
# Se 'phi3.5' non è disponibile in locale, usa: FROM phi3:mini
FROM phi3.5

# Parametri stabili (puoi sempre sovrascriverli da code a runtime)
PARAMETER temperature 0.3
PARAMETER top_p 0.85
PARAMETER top_k 50
PARAMETER repeat_penalty 1.2
PARAMETER repeat_last_n 512
PARAMETER presence_penalty 0.3
PARAMETER frequency_penalty 0.3
PARAMETER num_predict 900
PARAMETER num_ctx 8192

# Sentinel di chiusura: il modello lo emette a fine risposta
PARAMETER stop "[[END_OF_OUTPUT]]"

# Guard-rail in italiano
SYSTEM """
Parla SEMPRE in italiano, tono diretto e operativo.
Evita meta-istruzioni (es. 'continue', '800 parole'), placeholder (#14, x%) e tag speciali (<|...|>, |_|).
Rispondi in 1 breve paragrafo OPPURE elenco di passi chiari.
Chiudi SEMPRE con il token [[END_OF_OUTPUT]] e poi fermati.
"""
